# Eclipse — Supabase Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env.local and fill in your actual Supabase project values.
# NEVER commit .env.local to git (it is already in .gitignore).
#
# Find these values in:
#   Supabase Dashboard → Your Project → Settings → API
#
# After editing this file, restart the dev server (npm run dev) for changes
# to take effect. For Vercel deployments, add these same variables in:
#   Vercel Dashboard → Your Project → Settings → Environment Variables
#   (enable for Production, Preview, and Development as needed)
#   Then redeploy — Vite bakes env vars into the bundle at build time.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
